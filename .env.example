DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-development-only-change-before-deploying
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
ROUTING_PROVIDER=valhalla
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de
ROUTING_CLIENT_ID=spotter-assessment-local
OSRM_BASE_URL=https://router.project-osrm.org
WEATHER_BASE_URL=https://api.open-meteo.com
GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com

# Search country scope (empty for worldwide)
GEOCODING_COUNTRY=US

# Exact frontend origins permitted to call the API across domains (comma-separated).
# Leave empty for the same-origin local Vite/Nginx setup.
CORS_ALLOWED_ORIGINS=
